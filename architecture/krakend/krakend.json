{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "timeout": "5000ms",
  "name": "KrakenD - API Gateway",
  "output_encoding": "no-op",
  "port": 8081,
  "input_headers": [
    "Content-Type",
    "Host",
    "X-Forwarded-Proto",
    "X-Forwarded-Host",
    "X-Forwarded-For",
    "Origin",
    "Cookie",
    "Authorization",
    "X-User-Role",
    "X-User-Id"
  ],
  "extra_config": {
    "security/cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["*"],
      "expose_headers": ["Content-Length"],
      "max_age": "43200s",
      "allow_credentials": false,
      "debug": true
    }
  },
