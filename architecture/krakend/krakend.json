          "encoding": "json",
          "host": [
            "http://userservice:8080"
          ]
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/main_one/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "cache": true,
          "cache_duration": 900,
          "roles_key": "realm_access.roles",
          "roles_key_is_nested": true,
          "roles": ["user", "owner", "admin"],
